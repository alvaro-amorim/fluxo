+function getNextDuplicateEdgeHandles(
+  existingEdges: Edge[],
+  existingNodes: Node[],
+  source: string,
+  target: string,
+  requestedSourceHandle: FluxoEdgeSerialized["sourceHandle"] | undefined,
+  requestedTargetHandle: FluxoEdgeSerialized["targetHandle"] | undefined,
+): Pick<FluxoEdgeSerialized, "sourceHandle" | "targetHandle"> {
+  const duplicateCount = existingEdges.filter(
+    (edge) => edge.source === source && edge.target === target,
+  ).length;
+
+  const sourceHandle = requestedSourceHandle ?? "auto";
+  const targetHandle = requestedTargetHandle ?? "auto";
+
+  if (duplicateCount === 0) {
+    return { sourceHandle, targetHandle };
+  }
+
+  const pair = getDuplicateHandlePairs(existingNodes, source, target)[
+    duplicateCount % getDuplicateHandlePairs(existingNodes, source, target).length
+  ];
+
+  return {
+    sourceHandle: shouldAutoSlotDuplicateHandle(sourceHandle) ? pair.sourceHandle : sourceHandle,
+    targetHandle: shouldAutoSlotDuplicateHandle(targetHandle) ? pair.targetHandle : targetHandle,
+  };
+}
+
+function shouldAutoSlotDuplicateHandle(handle: string | undefined) {
+  if (!handle || handle === "auto") return true;
+
+  // Handles centrais como left/right/top/bottom podem ser redistribuidos em duplicatas.
+  // Handles especificos como right-top ou left-bottom sao respeitados.
+  return !handle.includes("-");
+}
+
+function getDuplicateHandlePairs(
+  existingNodes: Node[],
+  source: string,
+  target: string,
+): Array<Pick<FluxoEdgeSerialized, "sourceHandle" | "targetHandle">> {
+  const sourceCenter = getNodeCenter(existingNodes, source);
+  const targetCenter = getNodeCenter(existingNodes, target);
+  const dx = targetCenter.x - sourceCenter.x;
+  const dy = targetCenter.y - sourceCenter.y;
+
+  if (Math.abs(dx) >= Math.abs(dy)) {
+    return dx >= 0
+      ? [
+          { sourceHandle: "right", targetHandle: "left" },
+          { sourceHandle: "right-top", targetHandle: "left-top" },
+          { sourceHandle: "right-bottom", targetHandle: "left-bottom" },
+          { sourceHandle: "top-right", targetHandle: "top-left" },
+          { sourceHandle: "bottom-right", targetHandle: "bottom-left" },
+        ]
+      : [
+          { sourceHandle: "left", targetHandle: "right" },
+          { sourceHandle: "left-top", targetHandle: "right-top" },
+          { sourceHandle: "left-bottom", targetHandle: "right-bottom" },
+          { sourceHandle: "top-left", targetHandle: "top-right" },
+          { sourceHandle: "bottom-left", targetHandle: "bottom-right" },
+        ];
+  }
+
+  return dy >= 0
+    ? [
+        { sourceHandle: "bottom", targetHandle: "top" },
+        { sourceHandle: "bottom-left", targetHandle: "top-left" },
+        { sourceHandle: "bottom-right", targetHandle: "top-right" },
+        { sourceHandle: "left-bottom", targetHandle: "left-top" },
+        { sourceHandle: "right-bottom", targetHandle: "right-top" },
+      ]
+    : [
+        { sourceHandle: "top", targetHandle: "bottom" },
+        { sourceHandle: "top-left", targetHandle: "bottom-left" },
+        { sourceHandle: "top-right", targetHandle: "bottom-right" },
+        { sourceHandle: "left-top", targetHandle: "left-bottom" },
+        { sourceHandle: "right-top", targetHandle: "right-bottom" },
+      ];
+}
+
+function getNodeCenter(existingNodes: Node[], nodeId: string) {
+  const node = existingNodes.find((item) => item.id === nodeId);
+  const data = node?.data as FluxoNodeData | undefined;
+  const width = data?.width ?? 180;
+  const height = data?.height ?? 80;
+
+  return {
+    x: (node?.position.x ?? 0) + width / 2,
+    y: (node?.position.y ?? 0) + height / 2,
+  };
+}
 
